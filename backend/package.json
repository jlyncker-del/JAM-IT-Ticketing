{
  "name": "@jam-it/backend",
  "private": true,
  "type": "module",
  "engines": {"node": "22.x", "npm": ">=10.9.0 <12"},
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:render": "prisma migrate deploy && node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "multer": "latest",
    "nodemailer": "latest",
    "swagger-ui-express": "latest",
    "yauzl": "^3.4.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/multer": "latest",
    "@types/node": "22.x",
    "@types/nodemailer": "latest",
    "@types/supertest": "latest",
    "@types/swagger-ui-express": "latest",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "prisma": "6.19.3",
    "supertest": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "yazl": "^3.3.1"
  }
}
